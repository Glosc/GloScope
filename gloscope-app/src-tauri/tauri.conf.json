{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gloscope-app",
  "version": "0.1.0",
  "identifier": "com.gloscope.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "gloscope-app",
        "width": 800,
        "height": 600,
        "additionalBrowserArgs": "--remote-debugging-port=9333 --remote-allow-origins=*"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
